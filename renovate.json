{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "labels": [
        "dependencies"
    ],
    "schedule": [
        "before 3am"
    ],
    "automerge": true,
    "packageRules": [
        {
            "description": "Automerge dependencies",
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "automerge": true
        },
        {
            "description": "Ensure ghcr.io/openclaw/openclaw is updated and automerged",
            "matchPackageNames": [
                "ghcr.io/openclaw/openclaw"
            ],
            "matchDatasources": [
                "docker"
            ],
            "automerge": true
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Pinned ARG *_VERSION=vX.Y.Z lines annotated with a renovate comment",
            "managerFilePatterns": [
                "/^Dockerfile$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+_VERSION=(?<currentValue>v[\\d.]+)"
            ],
            "versioningTemplate": "semver"
        }
    ]
}
